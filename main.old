let bodyIndex = 0;

for (let x = 0; x < size; x++) {
  for (let y = 0; y < size; y++) {
    for (let z = 0; z < size; z++) {
      const visible =
        x === 0 ||
        x === size - 1 ||
        y === 0 ||
        y === size - 1 ||
        z === 0 ||
        z === size - 1;
      if (!visible) continue;
      cubies.push(new Cubie(x, y, z));
    }
  }
}

const count = cubies.length;
