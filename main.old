import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
const size = 100;
const cubeSize = 0.7;

const gap = 0.3;
const sphereOffset = size * 1.25;
const stretchAmount = 0;

const cellSize = cubeSize + gap;

const halfCenters = ((size - 1) / 2) * cellSize;

// ====================
// GEOMETRY
// ====================

const geometry = new THREE.BoxGeometry(cubeSize, cubeSize, cubeSize);
// const geometry = new RoundedBoxGeometry(cubeSize, cubeSize, cubeSize, 3, 0.1);
// const rightTopGeometry = geometry.clone();

// const rightBottomGeometry = geometry.clone();
// const rightFrontGeometry = geometry.clone();
// const rightBackGeometry = geometry.clone();

// stretchFace(rightTopGeometry, 'x', stretchAmount);
// stretchFace(rightTopGeometry, 'y', stretchAmount);

// stretchFace(rightBottomGeometry, 'x', stretchAmount);
// stretchFace(rightBottomGeometry, 'y', -stretchAmount);

// stretchFace(rightFrontGeometry, 'x', stretchAmount);
// stretchFace(rightFrontGeometry, 'z', stretchAmount);

// stretchFace(rightBackGeometry, 'x', stretchAmount);
// stretchFace(rightBackGeometry, 'z', -stretchAmount);

const rightGeometry = geometry.clone();
const frontGeometry = geometry.clone();
const upGeometry = geometry.clone();
const leftGeometry = geometry.clone();
const backGeometry = geometry.clone();
const downGeometry = geometry.clone();

stretchFace(rightGeometry, 'x', stretchAmount);
stretchFace(frontGeometry, 'z', stretchAmount);
stretchFace(upGeometry, 'y', stretchAmount);
stretchFace(leftGeometry, 'x', -stretchAmount);
stretchFace(backGeometry, 'z', -stretchAmount);
stretchFace(downGeometry, 'y', -stretchAmount);

const halfSize = (size * cellSize) / 2;

const cornerX = halfSize + stretchAmount;
const cornerY = halfSize + stretchAmount;
const cornerZ = halfSize + stretchAmount;

const sphereCenterX = -sphereOffset;
const bulgeRadius = Math.sqrt(
  (cornerX - sphereCenterX) ** 2 + cornerY ** 2 + cornerZ ** 2
);

console.log('bulgeRadius:', bulgeRadius);

const sphereCenterY = -sphereOffset;
const sphereCenterZ = -sphereOffset;
const sphereCenterXLeft = sphereOffset;
const sphereCenterYBottom = sphereOffset;
const sphereCenterZBack = sphereOffset;

const cornerSphereX =
  sphereCenterX + Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);
const cornerSphereY =
  sphereCenterY + Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);
const cornerSphereZ =
  sphereCenterZ + Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);
const cornerSphereXLeft =
  sphereCenterXLeft -
  Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);
const cornerSphereYBottom =
  sphereCenterYBottom -
  Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);
const cornerSphereZBack =
  sphereCenterZBack -
  Math.sqrt(bulgeRadius ** 2 - halfSize ** 2 - halfSize ** 2);

// ====================
// MATERIAL
// ====================

const bodyMaterial = new THREE.MeshStandardMaterial({
  color: 0x111111,
});

