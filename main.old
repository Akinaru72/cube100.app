// scene.add(rightTopMesh);
// scene.add(rightBottomMesh);
// scene.add(rightFrontMesh);
// scene.add(rightBackMesh);

// ====================
// MESHES
// ====================

const rightBodyMesh = new THREE.InstancedMesh(
  rightGeometry,
  bodyMaterial,
  size * size
);

const frontBodyMesh = new THREE.InstancedMesh(
  frontGeometry,
  bodyMaterial,
  size * size
);

