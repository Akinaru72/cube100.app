// ====================
// CUBIES
// ====================

const dummy = new THREE.Object3D();
const cubies = [];

for (let x = 0; x < size; x++) {
  for (let y = 0; y < size; y++) {
    for (let z = 0; z < size; z++) {
      const visible =
        x === 0 ||
        x === size - 1 ||
        y === 0 ||
        y === size - 1 ||
        z === 0 ||
        z === size - 1;

      if (!visible) continue;

      cubies.push(new Cubie(x, y, z));
    }
  }
}

// ====================
// LAYERS
// ====================

const layers = {
  x: Array.from({ length: size }, () => []),
  y: Array.from({ length: size }, () => []),
  z: Array.from({ length: size }, () => []),
};

// ====================
// INDICES
// ====================

let bodyIndex = 0;
let rightIndex = 0;
let frontIndex = 0;
let upIndex = 0;
let leftIndex = 0;
let backIndex = 0;
let downIndex = 0;

let rightTopIndex = 0;
let rightBottomIndex = 0;
let rightFrontIndex = 0;
let rightBackIndex = 0;

// ====================
// PLACE CUBIES
// ====================
cubies.forEach(cubie => {
  const px = (cubie.x - (size - 1) / 2) * cellSize;
  const py = (cubie.y - (size - 1) / 2) * cellSize;
  const pz = (cubie.z - (size - 1) / 2) * cellSize;

  // Исходная позиция
  // Исходная позиция
  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  const normalMatrix = dummy.matrix.clone();

  // ====================
  // RIGHT
  // ====================

  if (cubie.x === size - 1) {
    const sphereX =
      sphereCenterX + Math.sqrt(bulgeRadius ** 2 - py ** 2 - pz ** 2);
    const bulgeOffset = sphereX - cornerSphereX;
    dummy.position.x = px + bulgeOffset;
    dummy.updateMatrix();
  }

  const rightMatrix = dummy.matrix.clone();

  // ====================
  // UP
  // ====================

  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  if (cubie.y === size - 1) {
    const sphereY =
      sphereCenterY + Math.sqrt(bulgeRadius ** 2 - px ** 2 - pz ** 2);
    const bulgeOffsetY = sphereY - cornerSphereY;
    dummy.position.y = py + bulgeOffsetY;
    dummy.updateMatrix();
  }

  const upMatrix = dummy.matrix.clone();

  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  if (cubie.z === size - 1) {
    const sphereZ =
      sphereCenterZ + Math.sqrt(bulgeRadius ** 2 - px ** 2 - py ** 2);

    const bulgeOffset = sphereZ - cornerSphereZ;
    dummy.position.z = pz + bulgeOffset;
    dummy.updateMatrix();
  }

  const frontMatrix = dummy.matrix.clone();

  // ====================
  // LEFT
  // ====================
  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  if (cubie.x === 0) {
    const sphereX =
      sphereCenterXLeft - Math.sqrt(bulgeRadius ** 2 - py ** 2 - pz ** 2);
    const bulgeOffsetX = sphereX - cornerSphereXLeft;
    dummy.position.x = px + bulgeOffsetX;
    dummy.updateMatrix();
  }

  const leftMatrix = dummy.matrix.clone();

  // ====================
  // DOWN
  // ====================
  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  if (cubie.y === 0) {
    const sphereY =
      sphereCenterYBottom - Math.sqrt(bulgeRadius ** 2 - px ** 2 - pz ** 2);
    const bulgeOffsetY = sphereY - cornerSphereYBottom;
    dummy.position.y = py + bulgeOffsetY;
    dummy.updateMatrix();
  }

  const downMatrix = dummy.matrix.clone();

  // ====================
  // BACK
  // ====================
  dummy.position.set(px, py, pz);
  dummy.updateMatrix();

  if (cubie.z === 0) {
    const sphereZ =
      sphereCenterZBack - Math.sqrt(bulgeRadius ** 2 - px ** 2 - py ** 2);
    const bulgeOffsetZ = sphereZ - cornerSphereZBack;
    dummy.position.z = pz + bulgeOffsetZ;
    dummy.updateMatrix();
  }

  const backMatrix = dummy.matrix.clone();

  if (cubie.x === size - 1) {
    rightBodyMesh.setMatrixAt(rightIndex++, rightMatrix);
  }

  if (cubie.y === size - 1) {
    upBodyMesh.setMatrixAt(upIndex++, upMatrix);
  }

  if (cubie.z === size - 1) {
    frontBodyMesh.setMatrixAt(frontIndex++, frontMatrix);
  }

  if (cubie.x === 0) {
    leftBodyMesh.setMatrixAt(leftIndex++, leftMatrix);
  }

  if (cubie.y === 0) {
    downBodyMesh.setMatrixAt(downIndex++, downMatrix);
  }

  if (cubie.z === 0) {
    backBodyMesh.setMatrixAt(backIndex++, backMatrix);
  }

  // if (cubie.x === 0) {
  //   leftBodyMesh.setMatrixAt(leftIndex++, normalMatrix);
  // }

  // if (cubie.z === 0) {
  //   backBodyMesh.setMatrixAt(backIndex++, normalMatrix);
  // }

  // if (cubie.y === 0) {
  //   downBodyMesh.setMatrixAt(downIndex++, normalMatrix);
  // }

  // ====================
  // RIGHT EDGES / CORNERS
  // ====================

  // if (cubie.x === size - 1 && cubie.y === size - 1) {
  //   rightTopMesh.setMatrixAt(rightTopIndex++, rightMatrix);
  // }

  // if (cubie.x === size - 1 && cubie.y === 0) {
  //   rightBottomMesh.setMatrixAt(rightBottomIndex++, rightMatrix);
  // }

  // if (cubie.x === size - 1 && cubie.z === size - 1) {
  //   rightFrontMesh.setMatrixAt(rightFrontIndex++, rightMatrix);
  // }

  // if (cubie.x === size - 1 && cubie.z === 0) {
  //   rightBackMesh.setMatrixAt(rightBackIndex++, rightMatrix);
  // }

  layers.x[cubie.x].push(cubie);
  layers.y[cubie.y].push(cubie);
  layers.z[cubie.z].push(cubie);
});

// ====================
// UPDATE
// ====================

bodyMesh.instanceMatrix.needsUpdate = true;
rightBodyMesh.instanceMatrix.needsUpdate = true;
frontBodyMesh.instanceMatrix.needsUpdate = true;
upBodyMesh.instanceMatrix.needsUpdate = true;
leftBodyMesh.instanceMatrix.needsUpdate = true;
backBodyMesh.instanceMatrix.needsUpdate = true;
downBodyMesh.instanceMatrix.needsUpdate = true;

// rightTopMesh.instanceMatrix.needsUpdate = true;
// rightBottomMesh.instanceMatrix.needsUpdate = true;
// rightFrontMesh.instanceMatrix.needsUpdate = true;
// rightBackMesh.instanceMatrix.needsUpdate = true;

// ====================
// CAMERA
// ====================

const camera = new THREE.PerspectiveCamera(
  75,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);
camera.position.set(15, 15, 15);
camera.lookAt(0, 0, 0);

// ====================
// RENDERER
// ====================

const renderer = new THREE.WebGLRenderer({
  antialias: true,
});
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// ====================
// LIGHT
// ====================

scene.add(new THREE.AmbientLight(0xffffff, 2));

const light = new THREE.DirectionalLight(0xffffff, 2);
light.position.set(100, 100, 100);
scene.add(light);

// ====================
// CONTROLS
// ====================

const controls = new OrbitControls(camera, renderer.domElement);

controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.enablePan = false;
controls.minDistance = 50;
controls.maxDistance = 600;

// ====================
// ANIMATION
// ====================

function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}

animate();

// ====================
// FUNCTIONS
// ====================
function stretchFace(geometry, axis, amount) {
  const pos = geometry.attributes.position;

  for (let i = 0; i < pos.count; i++) {
    if (axis === 'x') {
      const x = pos.getX(i);

      if (amount > 0 && x > 0) pos.setX(i, x + amount);
      if (amount < 0 && x < 0) pos.setX(i, x + amount);
    }

    if (axis === 'y') {
      const y = pos.getY(i);

      if (amount > 0 && y > 0) pos.setY(i, y + amount);
      if (amount < 0 && y < 0) pos.setY(i, y + amount);
    }

    if (axis === 'z') {
      const z = pos.getZ(i);

      if (amount > 0 && z > 0) pos.setZ(i, z + amount);
      if (amount < 0 && z < 0) pos.setZ(i, z + amount);
    }
  }

  pos.needsUpdate = true;
  geometry.computeVertexNormals();
}

