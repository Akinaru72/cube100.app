scene.add(bodyMesh);

// scene.add(cubes);

const layers = {
  x: Array.from({ length: size }, () => []),
  y: Array.from({ length: size }, () => []),
  z: Array.from({ length: size }, () => []),
};

let frontIndex = 0;
let rightIndex = 0;
let upIndex = 0;
let frontBodyIndex = 0;

const stickerGeometry = new THREE.PlaneGeometry(0.7, 0.7);

const frontMaterial = new THREE.MeshBasicMaterial({
  color: 0x00ff00,
  side: THREE.DoubleSide,
});

