function stretchFace(geometry, axis, amount) {
  const pos = geometry.attributes.position;

  for (let i = 0; i < pos.count; i++) {
    if (axis === 'x') {
      const x = pos.getX(i);
      if (x > 0) pos.setX(i, x + amount);
    }

    if (axis === 'y') {
      const y = pos.getY(i);
      if (y > 0) pos.setY(i, y + amount);
    }

    if (axis === 'z') {
      const z = pos.getZ(i);
      if (z > 0) pos.setZ(i, z + amount);
    }
  }

  pos.needsUpdate = true;
  geometry.computeVertexNormals();
}
