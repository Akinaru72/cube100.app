  frontMaterial,
  size * size
);

const rightMaterial = new THREE.MeshBasicMaterial({
  color: 0xff0000,
  side: THREE.DoubleSide,
  polygonOffset: true,
  polygonOffsetFactor: -1,
  polygonOffsetUnits: -1,
});

const rightMesh = new THREE.InstancedMesh(
  stickerGeometry,
  rightMaterial,
  size * size
);

const upMaterial = new THREE.MeshBasicMaterial({
  color: 0xffffff,
  side: THREE.DoubleSide,
  polygonOffset: true,
  polygonOffsetFactor: -1,
  polygonOffsetUnits: -1,
});

const upMesh = new THREE.InstancedMesh(
  stickerGeometry,
  upMaterial,
  size * size
);

scene.add(upMesh);
scene.add(rightMesh);
scene.add(frontMesh);

cubies.forEach((cubie, index) => {
  dummy.position.set(
    cubie.x - (size - 1) / 2,
    cubie.y - (size - 1) / 2,
    cubie.z - (size - 1) / 2
  );

  // let scale = 1;

  // const borders =
  //   (cubie.x === 0 || cubie.x === size - 1) +
  //   (cubie.y === 0 || cubie.y === size - 1) +
  //   (cubie.z === 0 || cubie.z === size - 1);

  // if (borders === 3)
  //   scale = 5; // угол
  // else if (borders === 2) scale = 5; // ребро

  // dummy.scale.set(scale, scale, scale);

  dummy.updateMatrix();
  // bodyMesh.setMatrixAt(index, dummy.matrix);
  const px = cubie.x - (size - 1) / 2;
  const py = cubie.y - (size - 1) / 2;
  const pz = cubie.z - (size - 1) / 2;

  if (cubie.z === size - 1) {
    // stickerDummy.position.set(px, py, pz + (cubeSize * scale) / 2 + 0.05);
    // stickerDummy.rotation.set(0, 0, 0);
    // stickerDummy.scale.set(scale, scale, scale);
    // stickerDummy.updateMatrix();
    stickerDummy.position.set(px, py, pz + cubeSize / 2 + 0.05);
    stickerDummy.rotation.set(0, 0, 0);
    stickerDummy.updateMatrix();
    frontMesh.setMatrixAt(frontIndex++, stickerDummy.matrix);
  }

  if (cubie.x === size - 1) {
    rightBodyMesh.setMatrixAt(rightIndex++, dummy.matrix);
  }

  if (cubie.z === size - 1) {
    frontBodyMesh.setMatrixAt(frontBodyIndex++, dummy.matrix);
  }

  if (cubie.x !== size - 1 && cubie.z !== size - 1) {
    bodyMesh.setMatrixAt(bodyIndex++, dummy.matrix);
  }
  // if (cubie.x === size - 1) {
  //   stickerDummy.position.set(px + cubeSize / 2 + 0.05, py, pz);
  //   stickerDummy.rotation.set(0, Math.PI / 2, 0);
  //   stickerDummy.updateMatrix();
  //   rightMesh.setMatrixAt(rightIndex++, stickerDummy.matrix);
  // }

  if (cubie.y === size - 1) {
    // stickerDummy.position.set(px, py + (cubeSize * scale) / 2 + 0.05, pz);
    // stickerDummy.rotation.set(-Math.PI / 2, 0, 0);
    // stickerDummy.scale.set(scale, scale, scale);
    // stickerDummy.updateMatrix();
    stickerDummy.position.set(px, py + cubeSize / 2 + 0.05, pz);
    stickerDummy.rotation.set(-Math.PI / 2, 0, 0);
    stickerDummy.updateMatrix();
    upMesh.setMatrixAt(upIndex++, stickerDummy.matrix);
  }
  cubie.instanceId = index;
  layers.x[cubie.x].push(cubie);
  layers.y[cubie.y].push(cubie);
  layers.z[cubie.z].push(cubie);
});

bodyMesh.instanceMatrix.needsUpdate = true;
frontMesh.instanceMatrix.needsUpdate = true;
rightBodyMesh.instanceMatrix.needsUpdate = true;
frontBodyMesh.instanceMatrix.needsUpdate = true;

const camera = new THREE.PerspectiveCamera(
  75,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);

camera.position.set(90, 90, 90);
camera.lookAt(0, 0, 0);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);
scene.add(new THREE.AmbientLight(0xffffff, 2));
const light = new THREE.DirectionalLight(0xffffff, 2);
light.position.set(100, 100, 100);
scene.add(light);

const controls = new OrbitControls(camera, renderer.domElement);

controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.enablePan = false;
controls.minDistance = 20;
controls.maxDistance = 400;

function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}

animate();



function skewGeometry(geometry, amount) {
  const pos = geometry.attributes.position;

  for (let i = 0; i < pos.count; i++) {
    const x = pos.getX(i);
    const y = pos.getY(i);

    if (x > 0 && y > 0) {
      pos.setX(i, x - amount);
      pos.setY(i, y - amount);
    }
  }

  pos.needsUpdate = true;
  geometry.computeVertexNormals();
}

